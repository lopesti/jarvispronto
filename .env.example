NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# --- Banco (OBRIGATÓRIO: defina senha forte, nunca use jarvis_secret em produção) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=ALTERE_PARA_SENHA_FORTE_AQUI
POSTGRES_DB=jarvispronto
DATABASE_URL=postgres://jarvis:ALTERE_PARA_SENHA_FORTE_AQUI@postgres:5432/jarvispronto
PGHOST=postgres
PGPORT=5432
PGUSER=jarvis
PGPASSWORD=ALTERE_PARA_SENHA_FORTE_AQUI
PGDATABASE=jarvispronto

# --- JWT (mínimo 16 caracteres, aleatório) ---
JWT_SECRET=gere_um_segredo_longo_e_aleatorio_aqui_32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7
JWT_ISSUER=jarvis-comercial
JWT_AUDIENCE=jarvis-panel
BCRYPT_ROUNDS=12

# --- IA ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Redis (cache + fila) ---
REDIS_URL=redis://redis:6379
USE_MESSAGE_QUEUE=0
WORKER_CONCURRENCY=5

# --- CORS: lista separada por vírgula (estrita em produção) ---
CORS_ORIGINS=https://seu-dominio.com,http://localhost,http://localhost:3000,http://localhost:3001

# --- Meta (opcional) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
