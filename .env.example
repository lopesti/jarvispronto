# =============================================================
# JARVIS Comercial — exemplo de .env
# Copie para .env e ajuste os valores
# =============================================================

# =============================================================
# App
# =============================================================
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# =============================================================
# Postgres
# POSTGRES_* é lido pelo docker-compose.yml (imagem oficial)
# DATABASE_URL é lido pelo engine (driver pg)
# =============================================================
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=troque_por_senha_longa_16_mais_chars
POSTGRES_DB=jarvispronto
DATABASE_URL=postgres://jarvis:troque_por_senha_longa_16_mais_chars@postgres:5432/jarvispronto

# =============================================================
# Redis / fila
# USE_MESSAGE_QUEUE=1 → API não abre socket WA; o worker é dono.
# USE_MESSAGE_QUEUE=0 → API abre socket WA e processa inline.
# =============================================================
REDIS_URL=redis://redis:6379
USE_MESSAGE_QUEUE=1
WORKER_CONCURRENCY=5

# Internal HTTP do worker (BUG-072) — usado pela API pra delegar
# comandos de WhatsApp (connect/qr/send) quando USE_MESSAGE_QUEUE=1.
WORKER_HTTP_PORT=3002
WORKER_INTERNAL_URL=http://worker:3002

# =============================================================
# JWT
# JWT_SECRET precisa ter 16+ caracteres (validado no boot)
# =============================================================
JWT_SECRET=troque_por_segredo_longo_aleatorio_min_16_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=90
JWT_ISSUER=jarvis-comercial
JWT_AUDIENCE=jarvis-panel
BCRYPT_ROUNDS=12

# =============================================================
# Registro de novos tenants
# Em produção, defina todos como false para desabilitar signup público.
# =============================================================
ALLOW_REGISTER=true
ENABLE_REGISTRATION=true
ALLOW_PUBLIC_SIGNUP=true

# =============================================================
# IA — pelo menos UM dos dois precisa estar configurado
# GROQ é o provider principal. GEMINI é fallback opcional:
# se GEMINI_API_KEY ficar vazio, a API loga aviso e só usa Groq.
# =============================================================
GROQ_API_KEY=
GEMINI_API_KEY=

# =============================================================
# Token compartilhado com o jarvis-simulator (engine/routes/internal.js)
# Gere algo aleatorio: openssl rand -hex 32
# =============================================================
INTERNAL_SIM_TOKEN=

# =============================================================
# Canais Meta (Instagram / Facebook) — opcional / roadmap
# Sem estas vars, a UI esconde Instagram e Messenger (BUG-053).
# Multi-tenant Meta ainda NÃO implementado (BUG-019 + BUG-034).
# =============================================================
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# =============================================================
# CORS — allowlist (vírgula). Em produção com Nginx same-origin
# pode incluir apenas o domínio público.
# =============================================================
CORS_ORIGINS=https://localhost,http://localhost,https://127.0.0.1,http://127.0.0.1

# =============================================================
# WhatsApp / Baileys
# =============================================================
# Pasta base das sessões. Vazio usa o default do container
# (/app/auth_info_jarvis). Cada tenant fica em company_<id>/.
WA_AUTH_DIR=

# Auto-connect opcional ao subir em modo inline (USE_MESSAGE_QUEUE=0).
# - 0 ou vazio → nenhum auto-connect (recomendado em produção multi-tenant).
# - <companyId>  → API conecta essa empresa no boot automaticamente.
# BUG-060: era usado mas não documentado.
WA_AUTO_CONNECT_COMPANY=0