NODE_ENV=production
PORT=3000
TRUST_PROXY=1

DATABASE_URL=postgres://jarvis:jarvis_secret@postgres:5432/jarvispronto
PGHOST=postgres
PGPORT=5432
PGUSER=jarvis
PGPASSWORD=jarvis_secret
PGDATABASE=jarvispronto

JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GEMINI_API_KEY=

# Token compartilhado com o jarvis-simulator (engine/routes/internal.js).
# Gere algo aleatório, ex: openssl rand -hex 32
INTERNAL_SIM_TOKEN=

# Opcional Meta (Instagram/Facebook)
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# CORS (dev). Em producao com Nginx same-origin pode ficar vazio.
CORS_ORIGINS=https://localhost,http://localhost,https://127.0.0.1,http://127.0.0.1

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=7
JWT_ISSUER=jarvis-comercial
JWT_AUDIENCE=jarvis-panel
BCRYPT_ROUNDS=12
