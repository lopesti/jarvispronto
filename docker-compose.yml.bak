services:
  nginx:
    image: nginx:1.27-alpine
    container_name: jarvis-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./nginx/certs:/etc/nginx/certs:ro
      - certbot_www:/var/www/certbot:ro
    depends_on:
      - api
      - frontend
    networks:
      - jarvis-net

  # Opcional: emitir/renovar Let's Encrypt (profile certbot)
  certbot:
    image: certbot/certbot:latest
    container_name: jarvis-certbot
    volumes:
      - certbot_www:/var/www/certbot
      - certbot_etc:/etc/letsencrypt
    profiles:
      - certbot

  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: jarvis-api
    restart: unless-stopped
    expose:
      - "3000"
    env_file:
      - .env
    environment:
      NODE_ENV: production
      PORT: 3000
      TRUST_PROXY: "1"
      DATABASE_URL: postgres://jarvis:jarvis_secret@postgres:5432/jarvispronto
      PGHOST: postgres
      PGPORT: 5432
      PGUSER: jarvis
      PGPASSWORD: jarvis_secret
      PGDATABASE: jarvispronto
    volumes:
      - jarvis_auth:/app/auth_info_jarvis
      - jarvis_logs:/app/logs
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - jarvis-net

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.frontend
      args:
        NEXT_PUBLIC_API_URL: ""
    container_name: jarvis-frontend
    restart: unless-stopped
    expose:
      - "3001"
    environment:
      NEXT_PUBLIC_API_URL: ""
      PORT: 3001
      HOSTNAME: 0.0.0.0
    depends_on:
      - api
    networks:
      - jarvis-net

  postgres:
    image: postgres:16-alpine
    container_name: jarvis-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: jarvis
      POSTGRES_PASSWORD: jarvis_secret
      POSTGRES_DB: jarvispronto
    ports:
      - "5432:5432"
    volumes:
      - jarvis_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U jarvis -d jarvispronto"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - jarvis-net

  simulator:
    build:
      context: ./jarvis-simulator
      dockerfile: Dockerfile
    container_name: jarvis-simulator
    restart: unless-stopped
    env_file:
      - ./jarvis-simulator/.env
    environment:
      JARVIS_INTERNAL_URL: http://api:3000/internal
    ports:
      - "4000:4000"
    depends_on:
      - api
    networks:
      - jarvis-net
    profiles:
      - simulator

  redis:
    image: redis:7-alpine
    container_name: jarvis-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - jarvis_redis:/data
    networks:
      - jarvis-net
    profiles:
      - full

volumes:
  jarvis_auth:
  jarvis_logs:
  jarvis_pgdata:
  jarvis_redis:
  certbot_www:
  certbot_etc:

networks:
  jarvis-net:
    driver: bridge