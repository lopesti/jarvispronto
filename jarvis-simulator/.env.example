PORT=4000

# URL interna do Jarvis dentro da rede Docker (nome do serviço, não localhost)
JARVIS_INTERNAL_URL=http://api:3000/internal

# Precisa ser IDÊNTICO ao INTERNAL_SIM_TOKEN configurado no .env do Jarvis
INTERNAL_SIM_TOKEN=troque_por_um_token_longo_e_aleatorio

# --- IA para gerar as falas dos clientes simulados ---
# Pode usar uma chave só (GROQ_API_KEY) ou várias separadas por vírgula
# (GROQ_API_KEYS) — o pool alterna entre elas em round-robin, e se uma
# der erro (ex: rate limit) tenta a próxima automaticamente.
# Os dois provedores abaixo são opcionais e combináveis: se preencher os
# dois, o pool junta Groq + Gemini e roda com o dobro da capacidade.

GROQ_API_KEY=
# GROQ_API_KEYS=chave1,chave2,chave3
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
# GEMINI_API_KEYS=chave1,chave2
GEMINI_MODEL=gemini-1.5-flash
